rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAllowed() {
      // Check if user's email is in the family allowlist
      let allowed = get(/databases/$(database)/documents/config/allowedEmails).data.emails;
      return request.auth.token.email in allowed;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isParent() {
      return userRole() == 'parent';
    }

    function isKid() {
      return userRole() == 'kid' || userRole() == 'parent';
    }

    // Guarded with exists() so a missing config/parentEmails doc denies the
    // 'parent' role (safe default) instead of erroring out profile creation
    // for everyone.
    function isDesignatedParent() {
      return exists(/databases/$(database)/documents/config/parentEmails) &&
        request.auth.token.email in
          get(/databases/$(database)/documents/config/parentEmails).data.emails;
    }

    // Config (allowlist) - parent-only read
    match /config/{document=**} {
      allow read: if isSignedIn() && isParent();
      allow write: if false; // Managed via CLI/console only for security
    }

    // User profiles
    match /users/{uid} {
      allow read: if isSignedIn() && isAllowed();
      // Role is validated, not trusted from the client: it must match
      // whichever role isDesignatedParent() computes from the signed-in
      // user's real auth token email.
      allow create: if request.auth.uid == uid && isAllowed() &&
        request.resource.data.role ==
          (isDesignatedParent() ? 'parent' : 'kid');
      // Role can't be changed by the user themselves after creation —
      // otherwise a kid could edit their own doc to grant themselves parent.
      allow update: if request.auth.uid == uid &&
        request.resource.data.role == resource.data.role;

      match /profile {
        allow read: if isSignedIn() && isAllowed();
        allow write: if request.auth.uid == uid;
      }

      match /stats/{document=**} {
        allow read: if isSignedIn() && isAllowed();
        allow write: if request.auth.uid == uid;
      }

      match /wordSearchProgress/{puzzleId} {
        allow read, write: if request.auth.uid == uid;
      }

      match /catQueensProgress/{document=**} {
        allow read, write: if request.auth.uid == uid;
      }

      // Daily Word: one doc per day holding this player's guesses. Owner
      // only — it carries the day's answer, so a family member reading
      // someone else's would be reading the answer off their board.
      match /dailyWordProgress/{dateKey} {
        allow read, write: if request.auth.uid == uid;
      }
    }

    // Real-time 2-player games
    match /games/{gameId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.players ||
        resource.data.status == 'waiting'
      );
      allow create: if isSignedIn() && isAllowed() && isKid();
      // Either you're already a player making a move, or you're a family
      // member joining a game that's still waiting for an opponent — the
      // second clause is what lets a joiner add themselves to `players`,
      // since at that moment they aren't in the *existing* doc yet. Capped
      // at two players so a third person can't overwrite a live game.
      allow update: if isSignedIn() && isAllowed() && (
        request.auth.uid in resource.data.players ||
        (
          resource.data.status == 'waiting' &&
          request.auth.uid in request.resource.data.players &&
          request.resource.data.players.size() <= 2
        )
      );
      // Abandoned lobbies are cleaned up by whoever created them.
      allow delete: if isSignedIn() && request.auth.uid in resource.data.players;

      // Battleship: each player's fleet lives in their own subdoc. Writes
      // stay owner-only (nobody can tamper with someone else's fleet); reads
      // are open to the two players at that table, since the firing device
      // resolves shots against the opponent's layout client-side. Family
      // app, not a bank — the secret is only secret from non-players.
      match /players/{playerId} {
        allow read: if isSignedIn() && isAllowed() &&
          request.auth.uid in
            get(/databases/$(database)/documents/games/$(gameId)).data.players;
        allow write: if isSignedIn() && request.auth.uid == playerId;
      }
    }

    // Countdowns
    match /countdowns/{countdownId} {
      allow read: if isSignedIn() && isAllowed();
      allow create: if isSignedIn() && isAllowed() && isKid();
      allow update: if isSignedIn() && isAllowed();
      allow delete: if isSignedIn() && isAllowed();
    }

    // Presence heartbeats — "seen in the last minute" is a heuristic, not a
    // true live-connection signal (Firestore has no onDisconnect like
    // Realtime Database), but it's enough to show who's likely around.
    match /presence/{uid} {
      allow read: if isSignedIn() && isAllowed();
      allow write: if request.auth.uid == uid && isAllowed();
    }

    // Leaderboard entries. Immutable once written — no update/delete — so a
    // family top-10 can't be tampered with after the fact; the client can
    // only submit their own uid as the scorer.
    match /scores/{scoreId} {
      allow read: if isSignedIn() && isAllowed();
      allow create: if isSignedIn() && isAllowed() && isKid() &&
        request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // Word Search puzzles — generated server-side only (Cloud Function
    // calls Gemini for the word list, then a local algorithm builds the
    // grid). Never client-writable: a forged doc could hand a player a
    // pre-"solved" puzzle for score purposes.
    match /wordSearchPuzzles/{puzzleId} {
      allow read: if isSignedIn() && isAllowed();
      allow create, update: if false;
      allow delete: if isSignedIn() && isAllowed();
    }

    // Daily Word answers, one doc per day, written only by the getDailyWord
    // Cloud Function (which creates the day's word the first time anyone in
    // the family opens the game). Deliberately unreadable by clients: the
    // document *is* the answer, so a player who could read it would simply
    // look today's word up instead of playing. The function hands the word
    // back through its own response instead.
    match /dailyWords/{dateKey} {
      allow read, write: if false;
    }

    // Same reasoning as dailyWords: these documents hold the day's answers.
    // A player who could read the crossword doc would have the filled grid,
    // and the Word Bloom doc is the whole word list. Both are handed back
    // through their callable instead, which is also what creates them.
    match /crosswords/{dateKey} {
      allow read, write: if false;
    }

    match /bloomPuzzles/{dateKey} {
      allow read, write: if false;
    }

    // Shared word pools (WORD_BANK_PLAN.md §2) — same reasoning as
    // dailyWords/crosswords/bloomPuzzles above: a pool's contents are
    // unrevealed answers for whichever game hasn't served them yet, so a
    // player who could read it could just look the words up instead of
    // playing. Written only by the Cloud Functions that draw from and
    // refill it; handed back through their own callables instead.
    match /wordPool/{topicSlug} {
      allow read, write: if false;
    }

    // Per-game "already served" tracking for the pools above. Never needs
    // a client read either — nothing in the UI shows what's been used,
    // only what to play next.
    match /wordUsage/{usageId} {
      allow read, write: if false;
    }

    // Word Bloom's own pool (functions/src/bloomBank.ts) — same reasoning
    // as wordPool above, kept as a separate collection because each entry
    // is a whole puzzle (a base plus its derived word list), not a flat
    // word wordPool's shape could hold.
    match /bloomBasePool/{entryId} {
      allow read, write: if false;
    }

    // Schedule (merged from calendar + ICS)
    match /schedule/{eventId} {
      allow read: if isSignedIn() && isAllowed();
      allow write: if false; // Server-side only (Cloud Functions)
    }

    // Invite links for guest access to specific games
    match /invites/{inviteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isAllowed();
      allow update: if isSignedIn() && isAllowed();
    }
  }
}
